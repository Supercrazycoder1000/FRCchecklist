<checklist title="Robot Electrical Checklist">

  <section title="PREFLIGHT">
    <section title="PDH">
      <item>Breakers all the way in</item>
      <item>light pull test on power wires</item>
      <item>light pull test on CAN wires</item>
    </section>

    <section title="RIO">
      <item>light push on all duponts</item>
      <item>confirm power fully in</item>
      <item>light pull test on CAN</item>
      <item>light push on Ethernet</item>
    </section>

    <section title="RADIOS">
      <item>light push on all ethernet</item>
      <item>light pull test on power wires</item>
    </section>

    <section title="PWM">
      <item>light pull test on all wires</item>
    </section>

    <section title="WIRES">
      <item>visually inspect frame wires for damage around grommets and damage points</item>
      <item>visually inspect wires for climber interference</item>
    </section>

    <section title="BREAKER">
      <item>Confirm all breaker nuts TIGHT</item>
      <item>light pull on wires</item>
    </section>

    <section title="BATTERY">
      <item>Wiggle wires close to connectors</item>
      <item>light pull on wires</item>
    </section>

    <section title="LimeLight 3">
      <item>Push lightly on ethernet</item>
    </section>

    <section title="Limelight 4">
      <item>Light pull on test on power</item>
      <item>Light push on Ethernet</item>
    </section>
  </section>

  <section title="START UP" gate="true">
    <item>NEW BATTERY IN</item>
    <item>POWER ON BREAKER</item>
  </section>

</checklist>
